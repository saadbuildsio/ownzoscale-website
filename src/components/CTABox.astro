---
import Icon from './Icon.astro';
interface Props { title: string; text: string; primary?: { label: string; href: string }; secondary?: { label: string; href: string }; }
const { title, text, primary = { label: 'Discuss Your Project', href: '/contact' }, secondary = { label: 'Book a Strategy Call', href: '/book-a-call' } } = Astro.props;
---
<div class="ctab"><div class="in">
  <div><h2>{title}</h2><p>{text}</p></div>
  <div class="btns"><a class="btn btn-p" href={primary.href}>{primary.label} <Icon name="arrow" /></a><a class="btn btn-s" href={secondary.href}>{secondary.label}</a></div>
</div></div>
