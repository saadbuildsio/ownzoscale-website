---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Page not found | OwnzoScale" description="This page doesn't exist." noindex>
  <div slot="hero" class="wrap page-hero">
    <span class="pill">404</span>
    <h1>This page <em>doesn't exist.</em></h1>
    <p class="sub">The link may be old or mistyped. Here's where you can go instead:</p>
    <div class="ctas"><a class="btn btn-p" href="/">Home <Icon name="arrow" /></a><a class="btn btn-s" href="/services">Services</a><a class="btn btn-s" href="/contact">Contact</a></div>
  </div>
</BaseLayout>
